{
  "name": "obusk/wp-plugin-multisite-url-fixer",
  "type": "wordpress-muplugin",
  "license": "MIT",
  "description":
    "Fork of roots/multisite-url-fixer with domain-mapped multisite support",
  "homepage": "https://github.com/oBusk/wp-plugin-multisite-url-fixer",
  "keywords": ["wordpress", "bedrock", "multisite", "domain-mapping"],
  "support": {
    "issues": "https://github.com/oBusk/wp-plugin-multisite-url-fixer/issues"
  },
  "autoload": {
    "psr-4": {
      "Roots\\Bedrock\\": "src/"
    }
  },
  "require": {
    "php": ">=7.0.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.1"
  },
  "scripts": {
    "test": ["phpcs --ignore=vendor --extensions=php --standard=PSR2 ."]
  }
}
